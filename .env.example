# Copy this file to .env and fill in your own keys.
# .env is git-ignored — never commit real secrets.

# Weather data
TOMORROW_IO_KEY=your_tomorrow_io_key_here

# Exchange keys (only if the crypto side is used; otherwise leave blank)
BINANCE_KEY=
OKX_KEY=
OKX_SECRET=

# Telegram daily summary
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: override where runtime files (state, logs) are written.
# Defaults to /root on the droplet, or the repo dir locally.
# DATA_DIR=/root
